# macOS can return a dead socket when a timed connection is refused.
# Check the peer address before reporting a real forwarded-port collision.
# https://github.com/hashicorp/vagrant/issues/13845
if RUBY_PLATFORM.include?("darwin")
  require "vagrant/util/is_port_open"
  module Vagrant
    module Util
      module IsPortOpen
        def is_port_open?(host, port)
          Socket.tcp(host, port, connect_timeout: 0.1) do |connection|
            connection.remote_address
            true
          end
        rescue Errno::ETIMEDOUT, Errno::ECONNREFUSED, Errno::EHOSTUNREACH,
          Errno::ENETUNREACH, Errno::EACCES, Errno::ENOTCONN,
          Errno::EALREADY, Errno::EINVAL
          false
        end
        extend IsPortOpen
      end
    end
  end
end

# QEMU closes forwarded TLS connections until Windows starts WinRM.
# Retry this boot-time disconnect within Vagrant's normal boot timeout.
if defined?(VagrantPlugins::CommunicatorWinRM)
  module ImageFactoryWinRMBoot
    def ready?
      super
    rescue OpenSSL::SSL::SSLError, VagrantPlugins::CommunicatorWinRM::Errors::SSLError => error
      raise unless error.message.include?("unexpected eof while reading")

      sleep @machine.config.winrm.retry_delay
      false
    end
  end
  Vagrant.plugin("2").manager.communicators.get(:winrm).prepend(ImageFactoryWinRMBoot)
end

Vagrant.configure("2") do |config|
  config.vm.guest = :windows
  config.vm.communicator = "winrm"
  config.winrm.username = "vagrant"
  # The public Vagrant lab password is replaced by users after the first boot.
  config.winrm.password = ENV.fetch("IMAGE_FACTORY_WINDOWS_PASSWORD", "vagrant")
  config.winrm.transport = :ssl
  config.winrm.guest_port = 5986
  config.winrm.ssl_peer_verification = false
  config.vm.boot_timeout = 1800
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.network "forwarded_port", guest: 5986, host: 55986,
    host_ip: "127.0.0.1", id: "winrm-ssl", auto_correct: true
  config.vm.provider "qemu" do |qemu|
    qemu.arch = "aarch64"
    qemu.machine = "virt,accel=hvf"
    qemu.cpu = "host"
    qemu.smp = "4"
    qemu.memory = "8G"
    # Match the inbox NVMe storage used by the installation recipe.
    qemu.drive_interface = "none"
    qemu.net_device = "virtio-net-pci"
    # Windows boot needs a physical framebuffer even when the VM is headless.
    qemu.extra_qemu_args = ["-device", "ramfb",
      "-device", "nvme,drive=disk0,serial=image-factory"]
    qemu.graceful_timeout = 180
  end
end
