# macOS can return a dead socket when a timed connection is refused.
# Check the peer address before reporting a real forwarded-port collision.
# https://github.com/hashicorp/vagrant/issues/13845
if RUBY_PLATFORM.include?("darwin")
  require "vagrant/util/is_port_open"
  module Vagrant
    module Util
      module IsPortOpen
        def is_port_open?(host, port)
          Socket.tcp(host, port, connect_timeout: 0.1) do |connection|
            connection.remote_address
            true
          end
        rescue Errno::ETIMEDOUT, Errno::ECONNREFUSED, Errno::EHOSTUNREACH,
          Errno::ENETUNREACH, Errno::EACCES, Errno::ENOTCONN,
          Errno::EALREADY, Errno::EINVAL
          false
        end
        extend IsPortOpen
      end
    end
  end
end

Vagrant.configure("2") do |config|
  config.ssh.username = "ubuntu"
  config.ssh.insert_key = true
  config.vm.boot_timeout = 2700
  config.vm.cloud_init :user_data, content_type: "text/cloud-config", inline: "#cloud-config\npreserve_hostname: false\n"
  config.vm.synced_folder ".", "/vagrant", type: "rsync"
  config.vm.provider "qemu" do |qemu|
    qemu.arch = "aarch64"
  end
  config.vm.provider "libvirt" do |libvirt|
    libvirt.machine_arch = "aarch64"
    libvirt.machine_type = "virt"
  end
end
